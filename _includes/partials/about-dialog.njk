<dialog id="about-dialog" class="about-dialog app-dialog" aria-labelledby="about-dialog-title">
	<div class="dialog-panel">
		<header class="dialog-header">
			<h2 id="about-dialog-title" class="dialog-title">About {{ metadata.title }}</h2>
			<button type="button" class="dialog-close-btn about-dialog-close" aria-label="Close">
				{% include "partials/dialog-close-icon.njk" %}
			</button>
		</header>
		<div class="dialog-body about-dialog-body">
			<p class="about-dialog-intro">{{ metadata.description }}.</p>
			<h3 class="about-dialog-subtitle">How to use</h3>
			<ol class="about-dialog-list">
				<li>Explore every Crayola color in the list with sorting and filtering</li>
				<li>Open <strong>Filters</strong> to try a starter palette or build your own</li>
				<li>Tap <strong>⋯</strong> on a crayon to copy its hex code or add it to a palette</li>
				<li>Use <strong>Copy link</strong> to share a palette with someone else</li>
			</ol>
			<h3 class="about-dialog-subtitle">References</h3>
			<ul class="about-dialog-list">
				{% for reference in metadata.aboutReferences %}
				<li>
					<a
						class="about-dialog-link"
						href="{{ reference.url }}"
						target="_blank"
						rel="noopener"
					>{{ reference.label }}</a>
				</li>
				{% endfor %}
			</ul>
		</div>
	</div>
</dialog>
